<!--account.wxml-->
<view class="page">
  <navigation-bar title="账号设置" back="{{true}}" color="#1F2329" background="#FFFFFF"></navigation-bar>
  <scroll-view class="content" scroll-y>
    <view class="account-content">
      <view class="user-card">
        <view class="user-avatar">{{user.emoji}}</view>
        <view class="grow">
          <view class="user-name">{{user.nickName || user.name}}</view>
          <view wx:if="{{isLoggedIn}}" class="user-meta">ID {{user.id}} · 已登录</view>
          <view wx:else class="user-meta">未登录</view>
        </view>
      </view>

      <view wx:if="{{isLoggedIn}}" class="action-card">
        <view class="action-row" bindtap="switchUser" hover-class="action-row-hover" hover-stay-time="80">
          <view class="grow">
            <view class="action-title">切换账号</view>
            <view class="action-desc">使用其他账号登录</view>
          </view>
          <text class="action-arrow">›</text>
        </view>
        <view class="action-row" bindtap="logout" hover-class="action-row-hover" hover-stay-time="80">
          <view class="grow">
            <view class="action-title logout-title">{{loggingOut ? '退出中…' : '退出登录'}}</view>
            <view class="action-desc">撤销当前账号的登录状态</view>
          </view>
          <text class="action-arrow">›</text>
        </view>
      </view>

      <view wx:else class="action-card">
        <view class="action-row" bindtap="goLogin" hover-class="action-row-hover" hover-stay-time="80">
          <view class="grow">
            <view class="action-title">登录 / 注册</view>
            <view class="action-desc">添加菜品并与好友聊天</view>
          </view>
          <text class="action-arrow">›</text>
        </view>
      </view>

      <view class="account-note">切换账号不会主动退出当前账号；退出登录会撤销当前设备的登录状态。</view>
    </view>
  </scroll-view>
</view>
