.profile-page {
  background: #F6F7F9;
}

.profile-content {
  padding: 24rpx 24rpx 40rpx;
}

.chef-card {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
  padding: 28rpx 24rpx;
  border: 2rpx solid #FFE4D0;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF9F0, #FFEBD8);
}

.chef-card::after {
  content: '';
  position: absolute;
  right: -60rpx;
  bottom: -90rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
}

.chef-stage {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 132rpx;
  height: 132rpx;
  margin-right: 20rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(217, 106, 43, 0.12);
  animation: chef-float 3s ease-in-out infinite;
}

.chef-stage-hover {
  opacity: 0.82;
}

.chef-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.chef-badge {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 50%;
  background: #FFF3E6;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.chef-steam {
  position: absolute;
  top: -16rpx;
  color: #FFB98A;
  font-size: 34rpx;
  animation: chef-steam 2.4s ease-out infinite;
}

.steam-one { left: 34rpx; }
.steam-two { right: 34rpx; animation-delay: 1.1s; }

.chef-sparkle {
  position: absolute;
  top: 10rpx;
  right: 8rpx;
  color: #FF8A3D;
  font-size: 28rpx;
  animation: chef-sparkle 1.8s ease-in-out infinite;
}

.chef-info {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.chef-name {
  color: #4A3023;
  font-size: 32rpx;
  font-weight: 700;
}

.chef-role {
  margin-top: 8rpx;
  color: #8B6A52;
  font-size: 22rpx;
}

.gender-options {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.gender-option {
  margin-right: 10rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255, 107, 53, 0.2);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #9A6B45;
  font-size: 21rpx;
}

.gender-option.active {
  border-color: #FF6B35;
  background: #FF6B35;
  color: #FFFFFF;
}

.gender-hint {
  margin-top: 16rpx;
  color: #A87E61;
  font-size: 21rpx;
}

.score-pill {
  position: relative;
  z-index: 1;
  align-self: flex-start;
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.78);
  text-align: center;
}

.score-label {
  display: block;
  color: #9A6B45;
  font-size: 19rpx;
}

.score-value {
  display: block;
  margin-top: 4rpx;
  color: #FF6B35;
  font-size: 34rpx;
  font-weight: 700;
}

@keyframes chef-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes chef-steam {
  0% { opacity: 0; transform: translateY(10rpx); }
  40% { opacity: 0.9; }
  100% { opacity: 0; transform: translateY(-18rpx); }
}

@keyframes chef-sparkle {
  0%, 100% { opacity: 0.5; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.profile-login-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #FFD8C7;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #FF6B35;
  font-size: 27rpx;
}

.profile-login-hover {
  background: #FFF5F0;
}

.login-arrow {
  margin-left: 16rpx;
  font-size: 34rpx;
  line-height: 1;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 4rpx 18rpx;
}

.section-heading {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.section-head .section-title {
  margin-bottom: 0;
  font-size: 30rpx;
}

.dish-count {
  margin-left: 12rpx;
  color: #A0A5AD;
  font-size: 23rpx;
}

.add-entry {
  height: 60rpx;
  padding: 0 22rpx;
  border: 2rpx solid #FFD8C7;
  border-radius: 12rpx;
  background: #FFFFFF;
  color: #FF6B35;
  font-size: 25rpx;
  line-height: 56rpx;
}

.add-entry-hover {
  background: #FFF5F0;
}

.add-form {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #EEF0F2;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.form-label {
  margin: 20rpx 0 12rpx;
  font-size: 24rpx;
  color: #6B7078;
}

.add-form .form-label:first-child {
  margin-top: 0;
}

.emoji-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.emoji-item {
  width: 64rpx;
  height: 64rpx;
  margin: 0 12rpx 12rpx 0;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background: #F6F7F9;
  font-size: 34rpx;
  line-height: 60rpx;
  text-align: center;
}

.emoji-item.active {
  border-color: #FF6B35;
  background: #FFF5F0;
}

.form-input {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #F6F7F9;
  font-size: 26rpx;
  color: #1F2329;
}

.form-placeholder {
  color: #B9BDC4;
}

.save-btn {
  height: 76rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #FF6B35;
  box-shadow: none;
  font-size: 27rpx;
  line-height: 76rpx;
}

.empty-card {
  padding: 48rpx 24rpx;
  border: 2rpx solid #EEF0F2;
  border-radius: 16rpx;
  background: #FFFFFF;
  text-align: center;
}

.empty-card .empty-emoji {
  margin-bottom: 16rpx;
  font-size: 56rpx;
}

.empty-card .empty-title {
  margin-bottom: 8rpx;
  font-size: 27rpx;
}

.empty-card .empty-desc {
  margin-bottom: 0;
  font-size: 23rpx;
}

.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #EEF0F2;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.dish-card-hover {
  background: #FAFAFA;
}

.dish-pic {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dish-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.dish-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.dish-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.dish-name {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2329;
}

.dish-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: #FFF1E8;
  color: #FF6B35;
  font-size: 20rpx;
}

.dish-desc {
  margin-top: 10rpx;
  color: #8A8F99;
  font-size: 23rpx;
}

.delete-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 16rpx 4rpx 16rpx 16rpx;
  color: #A0A5AD;
  font-size: 23rpx;
}
