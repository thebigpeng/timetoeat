.profile-page {
  background: #F6F7F9;
}

.profile-content {
  padding: 24rpx 24rpx 40rpx;
}

.profile-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #EEF0F2;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.profile-avatar {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FFF3E6;
  font-size: 52rpx;
  line-height: 96rpx;
  text-align: center;
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}

.profile-sign {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8A8F99;
}

.login-state {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 23rpx;
  color: #A0A5AD;
}

.login-link {
  color: #FF6B35;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 4rpx 18rpx;
}

.section-heading {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.section-head .section-title {
  margin-bottom: 0;
  font-size: 30rpx;
}

.dish-count {
  margin-left: 12rpx;
  color: #A0A5AD;
  font-size: 23rpx;
}

.add-entry {
  height: 60rpx;
  padding: 0 22rpx;
  border: 2rpx solid #FFD8C7;
  border-radius: 12rpx;
  background: #FFFFFF;
  color: #FF6B35;
  font-size: 25rpx;
  line-height: 56rpx;
}

.add-entry-hover {
  background: #FFF5F0;
}

.add-form {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #EEF0F2;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.form-label {
  margin: 20rpx 0 12rpx;
  font-size: 24rpx;
  color: #6B7078;
}

.add-form .form-label:first-child {
  margin-top: 0;
}

.emoji-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.emoji-item {
  width: 64rpx;
  height: 64rpx;
  margin: 0 12rpx 12rpx 0;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background: #F6F7F9;
  font-size: 34rpx;
  line-height: 60rpx;
  text-align: center;
}

.emoji-item.active {
  border-color: #FF6B35;
  background: #FFF5F0;
}

.form-input {
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #F6F7F9;
  font-size: 26rpx;
  color: #1F2329;
}

.form-placeholder {
  color: #B9BDC4;
}

.save-btn {
  height: 76rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #FF6B35;
  box-shadow: none;
  font-size: 27rpx;
  line-height: 76rpx;
}

.empty-card {
  padding: 48rpx 24rpx;
  border: 2rpx solid #EEF0F2;
  border-radius: 16rpx;
  background: #FFFFFF;
  text-align: center;
}

.empty-card .empty-emoji {
  margin-bottom: 16rpx;
  font-size: 56rpx;
}

.empty-card .empty-title {
  margin-bottom: 8rpx;
  font-size: 27rpx;
}

.empty-card .empty-desc {
  margin-bottom: 0;
  font-size: 23rpx;
}

.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #EEF0F2;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.dish-card-hover {
  background: #FAFAFA;
}

.dish-pic {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dish-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.dish-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.dish-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.dish-name {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2329;
}

.dish-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: #FFF1E8;
  color: #FF6B35;
  font-size: 20rpx;
}

.dish-desc {
  margin-top: 10rpx;
  color: #8A8F99;
  font-size: 23rpx;
}

.delete-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 16rpx 4rpx 16rpx 16rpx;
  color: #A0A5AD;
  font-size: 23rpx;
}
