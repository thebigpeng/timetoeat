<!--profile.wxml-->
<view class="page profile-page">
  <navigation-bar title="{{titleText}}" back="{{false}}" color="#1F2329" background="#FFFFFF"></navigation-bar>
  <scroll-view class="content" scroll-y>
    <view class="profile-content tabbar-content">
      <view class="chef-card">
        <view class="chef-stage" bindtap="onAvatarTap" hover-class="chef-stage-hover" hover-stay-time="80" aria-role="button" aria-label="进入账号设置">
          <text class="chef-steam steam-one">⌇</text>
          <text class="chef-steam steam-two">⌇</text>
          <text class="chef-sparkle">✦</text>
          <text class="chef-emoji">{{chefEmoji}}</text>
          <view class="chef-badge">{{user.emoji}}</view>
        </view>
        <view class="chef-info">
          <view class="chef-name">{{user.name}}</view>
          <view class="chef-role ellipsis">{{chefLabel}}厨师 · {{user.signature}}</view>
          <view wx:if="{{isLoggedIn}}" class="gender-options">
            <view
              class="gender-option {{user.gender === item.value ? 'active' : ''}}"
              wx:for="{{genderOptions}}"
              wx:key="value"
              data-gender="{{item.value}}"
              bindtap="onGenderChange"
            >{{item.label}}</view>
          </view>
          <view wx:else class="gender-hint">登录后设置厨师形象</view>
        </view>
        <view class="score-pill">
          <text class="score-label">菜菜分</text>
          <text class="score-value">{{user.caicaiScore || 0}}</text>
        </view>
      </view>

      <view wx:if="{{!isLoggedIn}}" class="profile-login-entry" bindtap="goLogin" hover-class="profile-login-hover" hover-stay-time="80">
        <text>登录 / 注册，开始和好友蹭饭</text>
        <text class="login-arrow">›</text>
      </view>

      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">我会做的菜</text>
          <text class="dish-count">{{dishes.length}} 道</text>
        </view>
        <view class="add-entry" bindtap="toggleAdd" hover-class="add-entry-hover" hover-stay-time="80">
          {{showAdd ? '收起' : '+ 新增'}}
        </view>
      </view>

      <view wx:if="{{showAdd}}" class="add-form">
        <view class="form-label">选个图标</view>
        <view class="emoji-row">
          <view
            class="emoji-item {{form.emoji === item ? 'active' : ''}}"
            wx:for="{{emojiOptions}}"
            wx:key="*this"
            data-emoji="{{item}}"
            bindtap="chooseEmoji"
          >{{item}}</view>
        </view>
        <view class="form-label">菜名</view>
        <input class="form-input" value="{{form.name}}" placeholder="例如：可乐鸡翅" placeholder-class="form-placeholder" data-field="name" bindinput="onFormInput" />
        <view class="form-label">简介（选填）</view>
        <input class="form-input" value="{{form.desc}}" placeholder="一句话介绍这道菜" placeholder-class="form-placeholder" data-field="desc" bindinput="onFormInput" />
        <view class="primary-btn save-btn" bindtap="submitDish">保存菜品</view>
      </view>

      <view wx:if="{{dishes.length === 0}}" class="empty-card">
        <view class="empty-emoji">🍳</view>
        <view class="empty-title">还没有拿手菜</view>
        <view class="empty-desc">点击“新增”，添加你的第一道菜</view>
      </view>

      <view class="dish-list">
        <view class="dish-card" wx:for="{{dishes}}" wx:key="id" hover-class="dish-card-hover" hover-stay-time="80">
          <view class="dish-pic" style="background: {{item.bg}};">
            <text class="dish-emoji">{{item.emoji}}</text>
          </view>
          <view class="dish-body">
            <view class="dish-title-row">
              <view class="dish-name ellipsis">{{item.name}}</view>
              <text wx:if="{{item.tag}}" class="dish-tag">{{item.tag}}</text>
            </view>
            <view class="dish-desc ellipsis">{{item.desc}}</view>
          </view>
          <view wx:if="{{isLoggedIn}}" class="delete-btn" data-id="{{item.id}}" catchtap="removeDish">删除</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
