.splash-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #F8EEDD;
}

.splash-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.brand-block {
  position: absolute;
  top: calc(10vh + env(safe-area-inset-top));
  left: 0;
  width: 100%;
  text-align: center;
}

.brand-eyebrow {
  display: inline-block;
  margin-bottom: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #9A6B45;
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.brand-title {
  color: #4A3023;
  font-size: 78rpx;
  font-weight: 800;
  line-height: 1.16;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 18rpx rgba(255, 255, 255, 0.5);
}

.brand-title-accent {
  color: #D96A3C;
}

.brand-subtitle {
  margin-top: 24rpx;
  color: #8B6A52;
  font-size: 26rpx;
  letter-spacing: 3rpx;
}

.splash-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #F1E2CD;
  color: #8F6B50;
  font-size: 22rpx;
  line-height: 116rpx;
  text-align: center;
  letter-spacing: 3rpx;
}
