.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  background: #FFFFFF;
  border-top: 2rpx solid #F0F1F3;
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 41, 0.04);
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tabbar-hover {
  opacity: 0.65;
}

.tabbar-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
  background-color: #9AA0AA;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
}

.tabbar-item.selected .tabbar-icon,
.tabbar-text.active {
  color: #FF6B35;
}

.tabbar-item.selected .tabbar-icon {
  background-color: #FF6B35;
}

.tabbar-text {
  font-size: 22rpx;
  color: #8A8F99;
  line-height: 1.2;
}

.tabbar-text.active {
  font-weight: 600;
}

.tabbar-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

